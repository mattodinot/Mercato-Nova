# =====================================================
# Mercato Nova - variables d'environnement
# Copier ce fichier vers .env puis ajuster les valeurs.
# .env ne doit JAMAIS etre commit (ignore par .gitignore).
# =====================================================

APP_ENV=development
APP_URL=http://localhost:8000

# Base de donnees MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mercato_nova
DB_USER=root
DB_PASS=

# Sessions
SESSION_NAME=MNSESSID
SESSION_LIFETIME=7200

# CORS : origine du frontend (React en dev ou pages statiques)
CORS_ORIGIN=http://localhost:5173
